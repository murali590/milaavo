DB_URL=jdbc:postgresql://localhost:5432/milaavo
DB_USERNAME=
DB_PASSWORD=
# Base64-encoded, >= 32 bytes decoded. Generate with: openssl rand -base64 32
JWT_SECRET=
# Base64-encoded, >= 32 bytes decoded. Must differ from JWT_SECRET.
OTP_HMAC_SECRET=
# Base64-encoded, exactly 32 bytes decoded (AES-256). Encrypts SMS outbox messages.
# Must differ from the other secrets. Never change it while SMS are pending.
SMS_OUTBOX_ENCRYPTION_KEY=
# Only "local" has an SmsSender implementation today.
SPRING_PROFILES_ACTIVE=local
